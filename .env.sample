VITE_CHAT_URL='ws://chatbot-backend:8686'
VITE_CHAT_TOKEN=''

# URL gốc của REST API cũ (login, sessions, upload, mindmap, ...). Mặc định trong src/config.js: http://0.0.0.0:8686
VITE_API_URL='http://0.0.0.0:8686'

# Endpoint AG-UI (POST, trả về text/event-stream). Phải kết thúc bằng /agent:
# src/config.js bỏ đuôi /agent để suy ra gốc cho GET /threads/:id/messages và /health.
# Mock local: npm run mock:agent (cổng 8787). Backend thật sau này: http://<host>:8686/agent
VITE_AGENT_URL='http://localhost:8787/agent'

# Bật giao diện chat AG-UI (assistant-ui). Chỉ đúng chuỗi "true" mới bật; mọi giá trị khác giữ luồng WebSocket cũ.
VITE_USE_AGUI=false
