          <mxGeometry x="440" y="100" width="260" height="140" as="geometry" />
        </mxCell>

        <!-- Classify Intent (self-loop note inside router) -->
        <mxCell id="classify-note" value="Classify Intent&#xa;• Ask Question&#xa;• Summarize&#xa;• Create Mind Map&#xa;• Generate MCQ&#xa;• Others" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffffcc;strokeColor=#999999;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="750" y="100" width="180" height="140" as="geometry" />
        </mxCell>

        <!-- EVENT BUS -->
        <mxCell id="bus-box" value="Event Bus&#xa;(Kafka / Redis Streams)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#d5e8f7;strokeColor=#6AA8FF;fontStyle=1;fontSize=14;startSize=60;" vertex="1" parent="1">
          <mxGeometry x="400" y="320" width="340" height="140" as="geometry" />
