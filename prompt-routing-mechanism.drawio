        <mxCell id="bus" value="EVENT BUS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF0FF;strokeColor=#6AA8FF;fontSize=14;fontStyle=1" vertex="1" parent="bus-box">
